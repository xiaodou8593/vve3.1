#$(module_prefix)sound/friction
# $(module_prefix)sound/main调用

execute if score material_response int matches 1.. run function $(module_prefix)sound/friction_solid
execute if score material_response int matches -1 run function $(module_prefix)sound/friction_liquid
execute if score material_response int matches -2 run function $(module_prefix)sound/friction_solid

execute if score material_response int matches -3 run function $(module_prefix)sound/friction_type_1
execute if score material_response int matches -4 run function $(module_prefix)sound/friction_type_2
execute if score material_response int matches -5 run function $(module_prefix)sound/friction_type_3
execute if score material_response int matches -6 run function $(module_prefix)sound/friction_type_4

execute if score material_response int matches -7 run function $(module_prefix)sound/friction_water
execute if score material_response int matches -8 run function $(module_prefix)sound/friction_lava