function $(module_prefix)main_c
scoreboard players set inp int 7500
execute if score test_n int matches 60..72 at @s positioned ~-1 ~0.5 ~ rotated -90.0 0.0 run function $(module_prefix)_poke_here_i_as
execute as 0-0-0-0-0 run function vve:impulse/_render

scoreboard players add test_n int 1