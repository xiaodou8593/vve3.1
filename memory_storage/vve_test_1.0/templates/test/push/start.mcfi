#$(module_prefix)test/push/start
# 需要安装math3.1_gelib

function vve:_consts
function $(module_prefix)init

# 测试场地
execute as @e[tag=math_marker,limit=1] run function vve:test_coord/_topos
execute at @e[tag=math_marker,limit=1] run fill ~-2 ~ ~-2 ~6 ~5 ~2 air
execute at @e[tag=math_marker,limit=1] run fill ~-2 ~-1 ~-2 ~6 ~-1 ~2 grass_block

tag @e[tag=test] remove test

# 生成测试程序实体
data modify storage $(project_name):io input set from storage $(project_name):class $(module_name)_plate
function $(module_prefix)_proj
execute as @e[tag=math_marker,limit=1] at @s positioned ~ ~4 ~ rotated 0.0 0.0 run function vve:object/_anchor_to
function $(module_prefix)_model
data modify storage $(project_name):io input set from storage $(project_name):io result
data modify entity @e[tag=math_marker,limit=1] Pos set from storage $(project_name):io input.center
execute at @e[tag=math_marker,limit=1] run function $(module_prefix)_new
tag @e[tag=result,limit=1] add test
tag @e[tag=result,limit=1] remove $(project_name)_$(module_name)

execute as @e[tag=result,limit=1] run function marker_control:data/_get

# 设置测试程序主函数和销毁函数
data modify storage marker_control:io result.tick_func set value "$(module_prefix)test/push/main"
data modify storage marker_control:io result.del_func set value "$(module_prefix)test/push/end"

execute as @e[tag=result,limit=1] run function marker_control:data/_store
tag @e[tag=result,limit=1] add entity_ticked
tag @e[tag=result,limit=1] add entity_todel

# 设置测试程序运行时间
scoreboard players set @e[tag=result,limit=1] killtime 10
scoreboard players set test int -1
scoreboard players set test_n int 0

# 设置旋转
#execute as @e[tag=result,limit=1] at @s positioned ~5.0 ~5.0 ~5.0 run function vve:object/_rotate_here_as