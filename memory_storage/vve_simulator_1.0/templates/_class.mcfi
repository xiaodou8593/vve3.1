#$(module_prefix)_class
# 生成预设静态数据模板

function $(module_prefix)_zero
scoreboard players set global_rate int 1
scoreboard players set global_inv_dt int 1
scoreboard players set global_set_inv_dt int 1
function $(module_prefix)_model
data modify storage $(project_name):io $(module_name)_plate set from storage $(project_name):io result